		<key>MallocSpaceEfficient</key>
		<string>1</string>
	</dict>
	<key>NSAudioCaptureUsageDescription</key>
	<string>EQBar processes your Mac's sound output to apply equalization, spatial audio and volume. Audio is processed on your Mac and never recorded or sent anywhere.</string>
	<key>NSHumanReadableCopyright</key>
